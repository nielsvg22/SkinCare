# Copy this file to .env.local and fill in the real values.
# Get the Supabase values from: Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, never expose to the client. Used only by
# the /api/push/send-morning cron route to read all users' subscriptions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Random string (16+ chars) — protects the /api/push/send-morning cron route.
# Vercel automatically sends this as the Authorization header for Cron Jobs
# once it's set as a project env var.
CRON_SECRET=
